{
  "components": {
    "schemas": {
      "CheckRequest": {
        "additionalProperties": false,
        "properties": {
          "circuit_json": {
            "description": "A `circuit/1` document as JSON text. It is text, not an object, so that a key written twice is seen and refused (answer 400) instead of the last one winning.",
            "title": "Circuit Json",
            "type": "string"
          },
          "input": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "The input: a basis label such as `010` (wire 1 first) or a list of amplitudes, each a number or a `[re, im]` pair. Default |0...0>.",
            "title": "Input"
          },
          "target": {
            "$ref": "#/components/schemas/CheckTargetBody",
            "description": "Leave it out to compare the two sides of an equality drawn in the circuit. Sending `null` is refused."
          },
          "values": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "A value for each symbol of the circuit, a number or an angle as text such as `\\pi/2`.",
            "title": "Values"
          }
        },
        "required": [
          "circuit_json"
        ],
        "title": "CheckRequest",
        "type": "object"
      },
      "CheckTargetBody": {
        "additionalProperties": false,
        "description": "What to compare the circuit with. Give exactly one field.",
        "properties": {
          "circuit_json": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A second circuit, as JSON text (see the first `circuit_json`).",
            "title": "Circuit Json"
          },
          "state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "A state: a basis label or a list of amplitudes of norm 1.",
            "title": "State"
          },
          "unitary": {
            "anyOf": [
              {
                "items": {
                  "items": {},
                  "type": "array"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "A unitary matrix: rows of numbers or `[re, im]` pairs.",
            "title": "Unitary"
          }
        },
        "title": "CheckTargetBody",
        "type": "object"
      },
      "GateListResponse": {
        "properties": {
          "circuits": {
            "description": "Each circuit as a `circuit/1` document. To simulate one, send it as text in `circuit_json`.",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Circuits",
            "type": "array"
          },
          "status": {
            "description": "`parsed` when every circuit was fully read, `unparsed` when none was.",
            "enum": [
              "parsed",
              "partial",
              "unparsed"
            ],
            "title": "Status",
            "type": "string"
          },
          "text": {
            "description": "The gate list in words, as docingest gives it to the answer model.",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "status",
          "text",
          "circuits"
        ],
        "title": "GateListResponse",
        "type": "object"
      },
      "Health": {
        "properties": {
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "Health",
        "type": "object"
      },
      "ParseRequest": {
        "additionalProperties": false,
        "properties": {
          "latex": {
            "description": "The body of one code block: a quantikz, Qcircuit, yquant or tikz-cd source.",
            "title": "Latex",
            "type": "string"
          }
        },
        "required": [
          "latex"
        ],
        "title": "ParseRequest",
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 problem details (`application/problem+json`).",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "error_id": {
            "description": "Only on 500: the id in the server log.",
            "title": "Error Id",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ProblemField"
            },
            "title": "Errors",
            "type": "array"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ProblemField": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "path": {
            "description": "JSON pointer to the offending value.",
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ],
        "title": "ProblemField",
        "type": "object"
      },
      "RunRequest": {
        "additionalProperties": false,
        "properties": {
          "circuit_json": {
            "description": "A `circuit/1` document as JSON text. It is text, not an object, so that a key written twice is seen and refused (answer 400) instead of the last one winning.",
            "title": "Circuit Json",
            "type": "string"
          },
          "input": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "The input: a basis label such as `010` (wire 1 first) or a list of amplitudes, each a number or a `[re, im]` pair. Default |0...0>.",
            "title": "Input"
          },
          "unitary": {
            "default": false,
            "description": "Also list the unitary (up to 8 wires). `true` or `false` only.",
            "title": "Unitary",
            "type": "boolean"
          },
          "values": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "A value for each symbol of the circuit, a number or an angle as text such as `\\pi/2`.",
            "title": "Values"
          }
        },
        "required": [
          "circuit_json"
        ],
        "title": "RunRequest",
        "type": "object"
      },
      "Status": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "mode": {
            "description": "`live`, or `fake` when the service runs on test data.",
            "enum": [
              "live",
              "fake"
            ],
            "title": "Mode",
            "type": "string"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "uptime_s": {
            "title": "Uptime S",
            "type": "number"
          }
        },
        "required": [
          "mode",
          "api_version",
          "started_at",
          "uptime_s",
          "ready"
        ],
        "title": "Status",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Research engine API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/circuits/check": {
      "post": {
        "description": "Whether the circuit equals the target up to global phase. With no target, the two sides of an equality drawn in the circuit are compared. Up to 12 wires against a state and 8 for every comparison that builds a unitary. The body is quantum-sim's `quantum-sim-result/1` document as it is: `status` (`ok`, `symbolic` or `refused`), `conventions`, `input`, `circuits`, `comparisons`, `notes` and `refused`. A circuit the simulator refuses is a 200 with `status: refused`.",
        "operationId": "checkCircuit",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Checkcircuit",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The body is not valid JSON, or a JSON key is written twice (in the body or in a `circuit_json`)."
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The body is over the cap."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The request is not valid, or the circuit is over the synchronous caps (wires, operations, time); `detail` points to the `quantum-sim` command."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Circuit jobs are all busy; see `Retry-After`."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A problem."
          }
        },
        "summary": "Compare a circuit with a state, a unitary or another circuit",
        "tags": [
          "circuits"
        ]
      }
    },
    "/api/v1/circuits/conventions": {
      "get": {
        "description": "What `quantum-sim conventions` prints: the conventions every result states, the gate table and quantum-sim's own limits (the limits of this API are smaller and are named in its 422 answers).",
        "operationId": "getCircuitConventions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Getcircuitconventions",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A problem."
          }
        },
        "summary": "The conventions, the gate table and the limits of the simulator",
        "tags": [
          "circuits"
        ]
      }
    },
    "/api/v1/circuits/parse": {
      "post": {
        "description": "Reads quantikz, Qcircuit, yquant and tikz-cd source with docingest and returns the gate list in words and each circuit as a `circuit/1` document.",
        "operationId": "parseCircuit",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The body is not valid JSON, or a JSON key is written twice (in the body or in a `circuit_json`)."
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The body is over the cap."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The request is not valid, or the circuit is over the synchronous caps (wires, operations, time); `detail` points to the `quantum-sim` command."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Circuit jobs are all busy; see `Retry-After`."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A problem."
          }
        },
        "summary": "Read the circuits drawn in LaTeX",
        "tags": [
          "circuits"
        ]
      }
    },
    "/api/v1/circuits/run": {
      "post": {
        "description": "The state and the outcome probabilities of a circuit, and its unitary on request. Up to 12 wires, or 8 with the unitary, and up to the configured number of operations; a bigger one is a 422 that points to the `quantum-sim` command. The body is quantum-sim's `quantum-sim-result/1` document as it is: `status` (`ok`, `symbolic` or `refused`), `conventions`, `input`, `circuits`, `comparisons`, `notes` and `refused`. A circuit the simulator refuses is a 200 with `status: refused`.",
        "operationId": "runCircuit",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Runcircuit",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The body is not valid JSON, or a JSON key is written twice (in the body or in a `circuit_json`)."
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The body is over the cap."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The request is not valid, or the circuit is over the synchronous caps (wires, operations, time); `detail` points to the `quantum-sim` command."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Circuit jobs are all busy; see `Retry-After`."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A problem."
          }
        },
        "summary": "Simulate a circuit",
        "tags": [
          "circuits"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A problem."
          }
        },
        "summary": "Liveness check"
      }
    },
    "/api/v1/status": {
      "get": {
        "operationId": "getStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A problem."
          }
        },
        "summary": "State of the service"
      }
    }
  }
}
