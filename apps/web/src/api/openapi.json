{
  "components": {
    "schemas": {
      "Health": {
        "properties": {
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "Health",
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 problem details (`application/problem+json`).",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "error_id": {
            "description": "Only on 500: the id in the server log.",
            "title": "Error Id",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ProblemField"
            },
            "title": "Errors",
            "type": "array"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ProblemField": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "path": {
            "description": "JSON pointer to the offending value.",
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ],
        "title": "ProblemField",
        "type": "object"
      },
      "Status": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "mode": {
            "description": "`live`, or `fake` when the service runs on test data.",
            "enum": [
              "live",
              "fake"
            ],
            "title": "Mode",
            "type": "string"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "uptime_s": {
            "title": "Uptime S",
            "type": "number"
          }
        },
        "required": [
          "mode",
          "api_version",
          "started_at",
          "uptime_s",
          "ready"
        ],
        "title": "Status",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Research engine API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A problem."
          }
        },
        "summary": "Liveness check"
      }
    },
    "/api/v1/status": {
      "get": {
        "operationId": "getStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A problem."
          }
        },
        "summary": "State of the service"
      }
    }
  }
}
