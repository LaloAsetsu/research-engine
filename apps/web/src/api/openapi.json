{
  "components": {
    "schemas": {
      "CheckRequest": {
        "additionalProperties": false,
        "properties": {
          "circuit_json": {
            "description": "A `circuit/1` document as JSON text. It is text, not an object, so that a key written twice is seen and refused (answer 400) instead of the last one winning.",
            "title": "Circuit Json",
            "type": "string"
          },
          "input": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "The input: a basis label such as `010` (wire 1 first) or a list of amplitudes, each a number or a `[re, im]` pair. Default |0...0>.",
            "title": "Input"
          },
          "target": {
            "$ref": "#/components/schemas/CheckTargetBody",
            "description": "Leave it out to compare the two sides of an equality drawn in the circuit. Sending `null` is refused."
          },
          "values": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "A value for each symbol of the circuit, a number or an angle as text such as `\\pi/2`.",
            "title": "Values"
          }
        },
        "required": [
          "circuit_json"
        ],
        "title": "CheckRequest",
        "type": "object"
      },
      "CheckTargetBody": {
        "additionalProperties": false,
        "description": "What to compare the circuit with. Give exactly one field.",
        "properties": {
          "circuit_json": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A second circuit, as JSON text (see the first `circuit_json`).",
            "title": "Circuit Json"
          },
          "state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "A state: a basis label or a list of amplitudes of norm 1.",
            "title": "State"
          },
          "unitary": {
            "anyOf": [
              {
                "items": {
                  "items": {},
                  "type": "array"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "A unitary matrix: rows of numbers or `[re, im]` pairs.",
            "title": "Unitary"
          }
        },
        "title": "CheckTargetBody",
        "type": "object"
      },
      "GateListResponse": {
        "properties": {
          "circuits": {
            "description": "Each circuit as a `circuit/1` document. To simulate one, send it as text in `circuit_json`.",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Circuits",
            "type": "array"
          },
          "status": {
            "description": "`parsed` when every circuit was fully read, `unparsed` when none was.",
            "enum": [
              "parsed",
              "partial",
              "unparsed"
            ],
            "title": "Status",
            "type": "string"
          },
          "text": {
            "description": "The gate list in words, as docingest gives it to the answer model.",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "status",
          "text",
          "circuits"
        ],
        "title": "GateListResponse",
        "type": "object"
      },
      "Health": {
        "properties": {
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "Health",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "Me": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "language": {
            "enum": [
              "es",
              "en"
            ],
            "title": "Language",
            "type": "string"
          },
          "must_change_password": {
            "description": "True after an account is made or reset: every other endpoint answers 403 until the password is changed.",
            "title": "Must Change Password",
            "type": "boolean"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "display_name",
          "role",
          "must_change_password",
          "language"
        ],
        "title": "Me",
        "type": "object"
      },
      "ParseRequest": {
        "additionalProperties": false,
        "properties": {
          "latex": {
            "description": "The body of one code block: a quantikz, Qcircuit, yquant or tikz-cd source.",
            "title": "Latex",
            "type": "string"
          }
        },
        "required": [
          "latex"
        ],
        "title": "ParseRequest",
        "type": "object"
      },
      "PasswordChange": {
        "additionalProperties": false,
        "properties": {
          "current": {
            "description": "The password in use now.",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Current",
            "type": "string"
          },
          "new": {
            "description": "The new password: at least 12 characters, not the username, not a common password. Refusals come back as a 422 with a pointer to `/new`.",
            "maxLength": 1024,
            "title": "New",
            "type": "string"
          }
        },
        "required": [
          "current",
          "new"
        ],
        "title": "PasswordChange",
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 problem details (`application/problem+json`).",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "error_id": {
            "description": "Only on 500: the id in the server log.",
            "title": "Error Id",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ProblemField"
            },
            "title": "Errors",
            "type": "array"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ProblemField": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "path": {
            "description": "JSON pointer to the offending value.",
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ],
        "title": "ProblemField",
        "type": "object"
      },
      "Role": {
        "enum": [
          "admin",
          "member"
        ],
        "title": "Role",
        "type": "string"
      },
      "RunRequest": {
        "additionalProperties": false,
        "properties": {
          "circuit_json": {
            "description": "A `circuit/1` document as JSON text. It is text, not an object, so that a key written twice is seen and refused (answer 400) instead of the last one winning.",
            "title": "Circuit Json",
            "type": "string"
          },
          "input": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "The input: a basis label such as `010` (wire 1 first) or a list of amplitudes, each a number or a `[re, im]` pair. Default |0...0>.",
            "title": "Input"
          },
          "unitary": {
            "default": false,
            "description": "Also list the unitary (up to 8 wires). `true` or `false` only.",
            "title": "Unitary",
            "type": "boolean"
          },
          "values": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "A value for each symbol of the circuit, a number or an angle as text such as `\\pi/2`.",
            "title": "Values"
          }
        },
        "required": [
          "circuit_json"
        ],
        "title": "RunRequest",
        "type": "object"
      },
      "SessionOut": {
        "description": "A signed-in browser. The cookie value is never shown.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "current": {
            "description": "True for the session that made this request.",
            "title": "Current",
            "type": "boolean"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "last_seen_at": {
            "format": "date-time",
            "title": "Last Seen At",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "created_at",
          "last_seen_at",
          "expires_at",
          "current"
        ],
        "title": "SessionOut",
        "type": "object"
      },
      "Status": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "mode": {
            "description": "`live`, or `fake` when the service runs on test data.",
            "enum": [
              "live",
              "fake"
            ],
            "title": "Mode",
            "type": "string"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "uptime_s": {
            "title": "Uptime S",
            "type": "number"
          }
        },
        "required": [
          "mode",
          "api_version",
          "started_at",
          "uptime_s",
          "ready"
        ],
        "title": "Status",
        "type": "object"
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "description": "The HttpOnly session cookie set by `POST /auth/login`. Every `POST`, `PUT`, `PATCH` and `DELETE` must also carry the value of the `re_csrf` cookie in the `X-CSRF-Token` header, and an `Origin` header equal to the address of the service.",
        "in": "cookie",
        "name": "re_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Research engine API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/sessions": {
      "get": {
        "description": "Admin only. Cookie values are never shown.",
        "operationId": "listSessions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionOut"
                  },
                  "title": "Response Listsessions",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No session, or it has ended."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The CSRF header is missing or wrong, the password must be changed first, or the role is not enough."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A problem."
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "Signed-in browsers",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/sessions/{session_id}": {
      "delete": {
        "description": "Admin only. `404` when there is no such session.",
        "operationId": "endSession",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No session, or it has ended."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The CSRF header is missing or wrong, the password must be changed first, or the role is not enough."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such session."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The request is not valid."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A problem."
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "End a session",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Sets the `re_session` cookie (HttpOnly) and the `re_csrf` cookie. Answers `204`.\n\nA session the browser already held is ended, so signing in again leaves no old row behind.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Wrong username or password (one message for both)."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The request is not valid."
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many failed attempts.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before another attempt.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A problem."
          }
        },
        "summary": "Sign in",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Ends this session and clears both cookies.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No session, or it has ended."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The CSRF header is missing or wrong, the password must be changed first, or the role is not enough."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A problem."
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "Sign out",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "description": "Answers even while `must_change_password` is true, so the app knows to ask for it.",
        "operationId": "getMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No session, or it has ended."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The CSRF header is missing or wrong, the password must be changed first, or the role is not enough."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A problem."
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "The signed-in user",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/password": {
      "post": {
        "description": "Ends every session of the user and opens a new one: the response sets fresh cookies.",
        "operationId": "changePassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No session, or it has ended."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The current password is wrong, or the CSRF header is missing or wrong."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The request is not valid."
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many wrong passwords.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before another attempt.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A problem."
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "Change the password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/circuits/check": {
      "post": {
        "description": "Whether the circuit equals the target up to global phase. With no target, the two sides of an equality drawn in the circuit are compared. Up to 12 wires against a state and 8 for every comparison that builds a unitary. The body is quantum-sim's `quantum-sim-result/1` document as it is: `status` (`ok`, `symbolic` or `refused`), `conventions`, `input`, `circuits`, `comparisons`, `notes` and `refused`. A circuit the simulator refuses is a 200 with `status: refused`.",
        "operationId": "checkCircuit",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Checkcircuit",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The body is not valid JSON, or a JSON key is written twice (in the body or in a `circuit_json`)."
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The body is over the cap."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The request is not valid, or the circuit is over the synchronous caps (wires, operations, time); `detail` points to the `quantum-sim` command."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Circuit jobs are all busy; see `Retry-After`."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A problem."
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "Compare a circuit with a state, a unitary or another circuit",
        "tags": [
          "circuits"
        ]
      }
    },
    "/api/v1/circuits/conventions": {
      "get": {
        "description": "What `quantum-sim conventions` prints: the conventions every result states, the gate table and quantum-sim's own limits (the limits of this API are smaller and are named in its 422 answers).",
